TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=replace-with-turso-auth-token
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
BETTER_AUTH_URL=http://localhost:3000

# Optional: enables Google sign-in alongside email/password.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Used only while provisioning the tables, then disable it in Vercel.
ENABLE_SCHEMA_SETUP=false
SCHEMA_SETUP_TOKEN=replace-with-a-long-random-one-time-token

# Optional contact in Open Library's recommended User-Agent format.
OPEN_LIBRARY_USER_AGENT=Entrelinhas/1.0 (contact: you@example.com)

OPENAI_BASE_URL=https://copilot-mtcporto.vercel.app/v1
OPENAI_MODEL=gpt-4o
OPENAI_API_KEY=
